#!/bin/sh
# Shim: Claude Code spawns `caffeinate -i -t 300` during every turn to block idle sleep,
# and has no setting to turn that off (checked in 2.1.318: the gate is unconditional on macOS).
# When the parent process is claude, do nothing. Otherwise behave exactly like the real tool.
parent=$(ps -o comm= -p "$PPID" 2>/dev/null)
case "$parent" in
  claude|*/claude) exit 0 ;;
esac
exec /usr/bin/caffeinate "$@"
