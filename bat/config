# bat configuration
# https://github.com/sharkdp/bat#configuration-file

# Theme — TwoDark complements the ayu-dark Vim theme
--theme="TwoDark"

# Decorate terminal output; keep redirected output plain.
--style="auto"

# FZF previews request colors explicitly.
--color="auto"

# Use italic text where supported
--italic-text="always"
