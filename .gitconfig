[user]
  name  = Marian Posaceanu
  email = contact@marianposaceanu.com
[core]
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  editor = vim -f
	autocrlf = input
	excludesfile = ~/.gitignore_global
[web]
  browser = open
[push]
  autoSetupRemote = true
[diff]
  algorithm = histogram
[merge]
  conflictstyle = zdiff3
[rebase]
  autostash = true
[fetch]
  prune = true
[branch]
  sort = -committerdate
[rerere]
  enabled = true
[color "branch"]
  current = yellow reverse
  local   = yellow
  remote  = green
[color "diff"]
  meta = blue
  frag = magenta
  old  = red
  new  = green
[color "status"]
  added = yellow
  changed = green
  untracked = blue
[alias]
  d   = diff
  ds  = diff --staged
  dw  = diff --color-words
  s   = status -s -b
  c   = commit -v
  co  = checkout
  cp  = cherry-pick
  w   = log --raw --decorate
  wp  = log --decorate -p
  a   = add -u
  aa  = add --all :/
  td  = merge --no-ff
  sm  = submodule
  smu = submodule update --remote --recursive
  ap  = add -u -p
  pr  = "!f() { git fetch origin refs/pull/$1/head:pr/$1 && git co pr/$1; } ; f"
  up  = "!git fetch upstream && git rebase upstream/$(git remote show upstream 2>/dev/null | awk '/HEAD branch/ {print $NF}')"
  # original
  # l = log --pretty='format:%C(yellow)%h %C(blue)%ad %C(reset)%s%C(red)%d %C(green)%an%C(reset), %C(cyan)%ar' --date=short
  l = log --pretty='format:%C(yellow)%h %C(reset)%s%C(red)%d %C(green)%an%C(reset), %C(cyan)%ar' --date=short
  pom = push origin HEAD
  phm = push heroku HEAD
[init]
	defaultBranch = main
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
