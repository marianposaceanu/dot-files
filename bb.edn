{:paths ["." "test"]
 :tasks
 {test {:doc "Run all Clojure tests, or the named test namespaces."
        :requires ([test.runner :as runner])
        :task (apply runner/-main *command-line-args*)}
  test:unit {:doc "Run bootstrap and benchmark unit tests."
             :requires ([test.runner :as runner])
             :task (apply runner/-main runner/unit-test-namespaces)}
  test:integration {:doc "Run installer, editor, and benchmark integration tests."
                    :requires ([test.runner :as runner])
                    :task (apply runner/-main runner/integration-test-namespaces)}}}
